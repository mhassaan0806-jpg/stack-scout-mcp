{
  "_about": "Building blocks Stack Scout knows how to search for. 'query' is a GitHub search (topic: qualifiers give the cleanest results). 'language_sensitive' = apply the user's language filter (true for code libraries, false for self-hosted services you run beside any stack). 'keywords' match words in the user's idea. Archetypes map common app types to the blocks they usually need.",
  "components": {
    "auth":              {"name": "User login & accounts",            "query": "topic:authentication",       "language_sensitive": true,  "keywords": ["login", "log in", "sign in", "signin", "sign up", "signup", "accounts", "auth", "authentication", "members", "membership", "profiles"]},
    "database":          {"name": "Database",                         "query": "topic:database",             "language_sensitive": false, "keywords": ["database", "db", "store data", "save data", "records"]},
    "backend_api":       {"name": "Ready-made backend (BaaS)",        "query": "topic:backend-as-a-service", "language_sensitive": false, "keywords": ["backend", "api", "baas", "firebase", "supabase"]},
    "payments":          {"name": "Payments & checkout",              "query": "topic:payments -topic:crypto -topic:cryptocurrency -topic:blockchain -topic:web3 -topic:bitcoin", "language_sensitive": false,  "keywords": ["payment", "payments", "pay", "checkout", "stripe", "paypal", "donations", "tips"]},
    "billing":           {"name": "Subscriptions, billing & invoices", "query": "topic:billing",             "language_sensitive": false, "keywords": ["subscription", "subscriptions", "billing", "invoice", "invoices", "invoicing", "recurring", "plans", "pricing tiers"]},
    "ecommerce":         {"name": "Shopping cart & product catalog",  "query": "topic:ecommerce",            "language_sensitive": false, "keywords": ["cart", "shopping cart", "products", "catalog", "inventory", "orders", "store", "shop"]},
    "email":             {"name": "Sending email",                    "query": "topic:smtp -topic:sms", "language_sensitive": false,  "keywords": ["email", "emails", "newsletter", "mail", "mailing list", "receipts"]},
    "file_storage":      {"name": "File & image uploads / storage",   "query": "topic:object-storage",       "language_sensitive": false, "keywords": ["upload", "uploads", "files", "images", "photos", "storage", "attachments", "media"]},
    "search":            {"name": "Search",                           "query": "topic:full-text-search", "language_sensitive": false, "keywords": ["search", "find", "filter", "lookup"]},
    "admin_dashboard":   {"name": "Admin panel / internal dashboard", "query": "topic:admin-dashboard",      "language_sensitive": true,  "keywords": ["admin", "admin panel", "dashboard", "back office", "backoffice", "manage"]},
    "cms":               {"name": "Content management (CMS)",         "query": "topic:headless-cms",         "language_sensitive": false, "keywords": ["blog", "cms", "content", "articles", "posts", "pages", "editor"]},
    "analytics":         {"name": "Visitor analytics",                "query": "topic:web-analytics",        "language_sensitive": false, "keywords": ["analytics", "visitors", "traffic", "metrics", "stats", "tracking visitors"]},
    "notifications":     {"name": "Notifications (push, in-app, SMS)", "query": "topic:push-notifications",  "language_sensitive": false, "keywords": ["notification", "notifications", "push", "alerts", "sms", "reminders"]},
    "realtime_chat":     {"name": "Chat & real-time messaging",       "query": "topic:chat -topic:llm -topic:ai -topic:chatgpt -topic:ai-chat", "language_sensitive": false, "keywords": ["chat", "messaging", "messages", "messenger", "dm", "real-time", "realtime", "live"]},
    "comments":          {"name": "Comments & discussions",           "query": "topic:comments",             "language_sensitive": false, "keywords": ["comments", "comment", "discussion", "reviews", "ratings", "feedback"]},
    "forms":             {"name": "Forms & surveys",                  "query": "topic:forms",                "language_sensitive": true , "keywords": ["form", "forms", "survey", "surveys", "questionnaire", "quiz"]},
    "scheduling":        {"name": "Booking & scheduling",             "query": "topic:appointment-scheduling", "language_sensitive": false, "keywords": ["booking", "bookings", "appointment", "appointments", "schedule", "scheduling", "calendar", "reservation", "reservations"]},
    "maps":              {"name": "Maps & location",                  "query": "topic:maps",                 "language_sensitive": true,  "keywords": ["map", "maps", "location", "locations", "gps", "nearby", "directions", "delivery tracking"]},
    "video":             {"name": "Video hosting & player",           "query": "topic:video-player",         "language_sensitive": false, "keywords": ["video", "videos", "stream", "streaming", "player", "courses"]},
    "ui_components":     {"name": "UI component library",             "query": "topic:ui-components",        "language_sensitive": true,  "keywords": ["ui", "design system", "components", "buttons", "theme", "frontend"]},
    "background_jobs":   {"name": "Background jobs & queues",         "query": "topic:job-queue",            "language_sensitive": true,  "keywords": ["background job", "background jobs", "queue", "queues", "cron", "scheduled tasks", "worker"]},
    "monitoring":        {"name": "Error tracking & monitoring",      "query": "topic:error-monitoring",     "language_sensitive": false, "keywords": ["errors", "error tracking", "monitoring", "logs", "logging", "uptime", "crash"]},
    "feature_flags":     {"name": "Feature flags & A/B tests",        "query": "topic:feature-flags",        "language_sensitive": false, "keywords": ["feature flag", "feature flags", "a/b test", "ab test", "experiments", "rollout"]},
    "i18n":              {"name": "Translations (multi-language)",    "query": "topic:i18n topic:localization", "language_sensitive": true,  "keywords": ["translation", "translations", "multi-language", "multilingual", "languages", "i18n", "localization"]}
  },
  "archetypes": {
    "online store":      {"keywords": ["store", "shop", "ecommerce", "e-commerce", "sell", "selling", "merch", "retail", "boutique"],
                          "components": ["ecommerce", "payments", "auth", "database", "email", "search", "file_storage", "admin_dashboard", "analytics"]},
    "saas product":      {"keywords": ["saas", "subscription", "b2b", "startup", "workspace", "teams"],
                          "components": ["auth", "database", "billing", "payments", "email", "admin_dashboard", "analytics", "feature_flags", "monitoring", "background_jobs"]},
    "content site":      {"keywords": ["blog", "news", "magazine", "articles", "documentation", "docs", "portfolio", "podcast"],
                          "components": ["cms", "search", "comments", "analytics", "email"]},
    "community / social": {"keywords": ["social", "community", "forum", "social network", "followers", "feed", "dating"],
                          "components": ["auth", "database", "file_storage", "realtime_chat", "notifications", "comments", "search", "monitoring"]},
    "marketplace":       {"keywords": ["marketplace", "buyers", "sellers", "listings", "freelance", "freelancers", "rental", "classifieds"],
                          "components": ["auth", "database", "payments", "search", "file_storage", "realtime_chat", "notifications", "email", "admin_dashboard"]},
    "booking app":       {"keywords": ["booking", "appointment", "appointments", "reservation", "salon", "clinic", "restaurant", "gym", "tutor", "tutoring"],
                          "components": ["scheduling", "auth", "payments", "email", "notifications", "maps", "admin_dashboard"]},
    "messaging app":     {"keywords": ["chat app", "messaging", "messenger", "support desk", "helpdesk", "customer support"],
                          "components": ["realtime_chat", "auth", "notifications", "file_storage", "database"]},
    "internal tool":     {"keywords": ["internal tool", "crm", "inventory", "erp", "reporting", "back office", "dashboard"],
                          "components": ["admin_dashboard", "database", "auth", "forms", "analytics"]},
    "learning platform": {"keywords": ["course", "courses", "learning", "lms", "education", "school", "students", "teachers"],
                          "components": ["video", "auth", "payments", "cms", "file_storage", "email", "forms"]},
    "delivery / travel": {"keywords": ["delivery", "ride", "rides", "taxi", "tracking", "travel", "trips", "food delivery", "logistics"],
                          "components": ["maps", "auth", "payments", "notifications", "realtime_chat", "database", "admin_dashboard"]}
  },
  "default_components": ["auth", "database", "email", "file_storage", "analytics"]
}
